# OpenAI API key (required)
OPENAI_API_KEY=sk-...

# Model to use (default: gpt-5-mini)
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_RETRIES=2
DIGEST_OUTPUT_FILE=news.md
DIGEST_STATUS_FILE=digest-run-status.json
# Optional for repo-local issue preflight/publish. Leave unset to use local `gh` auth.
# GITHUB_TOKEN=github_pat_your_token_here
# Optional for Actions-dispatch publishing.
# DIGEST_PUBLISH_WORKFLOW=publish-digest.yml
# DIGEST_ACTIONS_REF=main

# Maximum number of papers to include per digest (default: 7)
PAPER_LIMIT=7

# Maximum Company News items to keep after ranking (default: 3, 0 = no limit)
COMPANY_NEWS_LIMIT=3

# RSS fetch timeout in seconds (default: 10)
RSS_TIMEOUT=10

# Number of retries for failed RSS fetches (default: 2)
RSS_RETRIES=2
RSS_MAX_WORKERS=8
RSS_MAX_FEED_BYTES=5000000

# Maximum items per source for digest diversity (default: 8, 0 = no limit)
MAX_ITEMS_PER_SOURCE=8
LOG_LEVEL=INFO
